[Unit]
Description=MPTCP tunnel to a TCP backend
Wants=network-online.target
After=network-online.target mptcp-ab-bootstrap.service
Requires=mptcp-ab-bootstrap.service
ConditionPathExists=/etc/mptcp-ab/server.env

[Service]
Type=simple
EnvironmentFile=/etc/mptcp-ab/server.env
ExecStart=/usr/local/bin/mptcp-port-tunnel server tcp --listen 0.0.0.0:${LANDING_PORT} --target ${LANDING_BACKEND} --max-connections 1024
Restart=always
RestartSec=2s
TimeoutStopSec=30s
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
